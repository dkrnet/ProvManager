# ProvManager sample configuration. Values shown are source defaults.
SITE_CONFIG_FILE=/etc/provmanager.conf
HOSTS_FILE=/data/provisioning/hosts.yaml
INSTALLERS_FILE=/data/provisioning/installers.yaml
ROLES_FILE=/data/provisioning/roles.yaml
TEMPLATES_FILE=/data/provisioning/templates.yaml
AUDIT_LOG_FILE=/var/log/provmanager/audit.log
TFTP_ROOT=/var/lib/tftp/efi/
DHCP_CONFIG_FILE=/etc/dhcp/dhcpd.conf
KICKSTART_ROOT=/data/provisioning/kickstart/
ANSIBLE_ROOT=/data/provisioning/ansible/
INVENTORY_OUTPUT_FILE=/data/provisioning/ansible/inventory/hosts.yml
GENERATED_OUTPUT_DIR=/data/provisioning/generated/
LOCK_DIR=/data/provisioning/locks/
BACKUP_DIR=/data/provisioning/backups/
PER_USER_CONFIG_DIR=/data/provisioning/user-config/
PM_ADMINS_GROUP=pm_admins
PM_AUDITORS_GROUP=pm_auditors
PM_PRVADMINS_GROUP=pm_prvadmins
PM_PRVUSERS_GROUP=pm_prvusers
PM_VIEWERS_GROUP=pm_viewers
BANNER_FILE=
BANNER_DIMENSIONS=
FAVICON_MIME_TYPE=image/x-icon
AUTH_FORM_ACTION=/login
AUTH_FORM_USERNAME_FIELD=httpd_username
AUTH_FORM_PASSWORD_FIELD=httpd_password
AUTH_FORM_LOCATION_FIELD=httpd_location
AUTH_FORM_DEFAULT_LOCATION=/cgi-bin/provmanager.cgi
LOGOUT_URL=/provmanager-logout
LIST_PAGE_SIZE=50
SEARCH_HISTORY_LIMIT=10
MAX_DESCRIPTION_CHARS=65536
MAX_TEMPLATE_BYTES=1048576

# These gates remain non-operational in the read-only initial milestone even if
# changed here. Apply, execution, service commands, and system writes are not
# implemented until their privileged integration contracts are specified.
ENABLE_PROVISIONING_EXECUTION=false
ENABLE_SERVICE_RELOAD=false
